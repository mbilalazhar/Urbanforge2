# Copy to .env.local and replace the URI with your MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/urbanforge
MONGODB_DB=urbanforge

# Optional: comma-separated DNS server IPs if Atlas TXT/SRV lookups time out.
# Empty uses system DNS. This changes Node's promise-based DNS resolver for the
# entire app process; use resolvers trusted by your deployment/network.
MONGODB_DNS_SERVERS=

# Required only for the API that creates admins. Generate at least 32 random characters.
# Never prefix this variable with NEXT_PUBLIC_ or include it in browser code.
ADMIN_PROVISIONING_KEY=
